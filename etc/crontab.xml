<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Exports the state gauges (cron lag, indexers, Mview backlog, queue backlog) every minute. -->
        <job name="bode_metrics_collect" instance="Bode\Metrics\Cron\Collect" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
